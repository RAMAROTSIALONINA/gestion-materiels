# Copier ce fichier en .env pour le travail en local. Le fichier .env n'est
# jamais versionné. En ligne, ces valeurs se saisissent dans les variables
# d'environnement de Render, jamais dans GitHub.
# Guide complet : docs/installation.md

# Serveur
PORT=3000
NODE_ENV=development

# Base de travail (Neon) : chaîne de connexion « pooled » copiée depuis la console Neon
DATABASE_URL=postgresql://utilisateur:mot_de_passe@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Base de TEST, vide (branche Neon « test ») : utilisée par npm test et npm run db:verifier.
# Jamais la même valeur que DATABASE_URL.
DATABASE_URL_TEST=postgresql://utilisateur:mot_de_passe@ep-yyyy-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Connexions simultanées à la base (offre gratuite : rester bas)
PG_POOL_MAX=5

# Clé de signature des sessions : 32 caractères au moins, différente en local et en ligne.
# Obligatoire en ligne. En local, sans elle, une clé provisoire est tirée à chaque démarrage
# (il faut alors se reconnecter après chaque redémarrage du serveur). Pour en tirer une :
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=a_remplacer

# Autres adresses autorisées à envoyer des écritures, séparées par des virgules.
# Vide en général : l'application et son API ont la même adresse.
CORS_ORIGIN=
